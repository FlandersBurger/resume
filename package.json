{
  "name": "resume",
  "scripts": {
    "rebuild": "rimraf dist && npm run bundle",
    "bundle": "tsc -p src/. && tsc-alias",
    "build": "tsc && tsc-alias",
    "watch": "tsx watch src/server.ts",
    "dev": "tsx src/server.ts",
    "start": "npm run build -- -w",
    "translate": "cd src/scripts && node i18n-scanner.js",
    "translate:verify": "cd src/scripts && node i18n-verify.js",
    "client:dev": "vite",
    "client:build": "vite build",
    "client:watch": "concurrently \"vite\" \"vite build --watch\"",
    "client:preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "prepare": "husky",
    "check:circular": "madge --circular --ts-config tsconfig.json --extensions ts src/",
    "check:client": "tsc --noEmit -p src/client/tsconfig.json"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.2",
    "asn1": "^0.2.6",
    "axios": "^1.21.1",
    "bcrypt-pbkdf": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "bson": "^7.3.4",
    "bull": "^4.16.5",
    "chart.js": "^4.6.1",
    "compression": "^1.8.2",
    "discord.js": "^14.28.1",
    "dompurify": "^3.4.17",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "firebase": "^13.3.0",
    "firebase-admin": "^14.5.1",
    "fuzzy-matching": "^0.4.3",
    "i18next": "^27.1.1",
    "i18next-fs-backend": "^2.6.12",
    "jwt-simple": "^0.6.1",
    "lodash": "^4.18.1",
    "module-alias": "^2.3.5",
    "moment": "^2.31.0",
    "mongoose": "^9.12.1",
    "mongoose-lean-virtuals": "^2.1.0",
    "morgan": "^1.12.1",
    "mtprotoproxy": "^2.0.0",
    "node-schedule": "^2.1.2",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-helmet-async": "^3.1.0",
    "react-router-dom": "^7.18.5",
    "redis": "^6.3.1",
    "rimraf": "^6.1.4",
    "styled-components": "^6.6.0",
    "tunnel-ssh": "^5.2.0",
    "ws": "^8.23.0",
    "xml2js": "^0.6.2"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "prettier --write"
  },
  "devDependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/bcrypt": "^6.0.0",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.27",
    "@types/moment": "^2.13.0",
    "@types/mongoose-lean-virtuals": "^0.5.6",
    "@types/node": "^26.6.6",
    "@types/node-schedule": "^2.1.8",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/styled-components": "^5.1.36",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "copyfiles": "^2.4.1",
    "husky": "^9.1.7",
    "i18n-auto-translation": "^2.2.3",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "madge": "^8.0.0",
    "mongodb-memory-server-core": "^11.3.0",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^23.1.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "subset-font": "^2.9.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "overrides": {
    "madge": {
      "typescript": "$typescript"
    },
    "@babel/plugin-transform-runtime": "^7.29.0"
  }
}
